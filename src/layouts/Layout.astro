---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
}

const {
  title,
  description = 'Patoli & Associates, CPA provides thoughtful tax, accounting, and advisory support for individuals and small businesses.',
  socialTitle = title,
  socialDescription = description,
} = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/new-client/', label: 'New Client' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About' },
  { href: '/book/', label: 'Book an Appointment' },
];

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/images/social-preview-v2.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // iOS Safari auto-zooms on form fields with sub-16px text, including inside
      // the booking iframe. maximum-scale=1 disables that auto-zoom on iOS while
      // still allowing manual pinch zoom; other platforms keep the default meta
      // because they would lose pinch zoom entirely.
      if (/iPhone|iPad|iPod/.test(navigator.userAgent)) {
        document
          .querySelector('meta[name="viewport"]')
          .setAttribute('content', 'width=device-width, initial-scale=1.0, maximum-scale=1.0');
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#153b35" />
    <meta name="apple-mobile-web-app-title" content="Patoli & Assoc." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Patoli & Associates, CPA" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Patoli & Associates, CPA, offering tax preparation, bookkeeping, accounting, and business advisory services." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Patoli & Associates, CPA, offering tax preparation, bookkeeping, accounting, and business advisory services." />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="construction-banner" role="status">
      <span>Website preview</span>
      Practice details and credentials are being finalized.
    </div>

    <header class="site-header">
      <div class="utility-bar">
        <div class="container utility-inner">
          <div class="utility-left">
            <a href="mailto:info@patolicpa.com">info@patolicpa.com</a>
            <span class="utility-divider" aria-hidden="true"></span>
            <a href="/portal/">Client Portal</a>
          </div>
          <p class="utility-right">Mon to Fri, 9 AM to 5 PM Central</p>
        </div>
      </div>

      <div class="header-main">
        <div class="container header-main-inner">
          <div class="header-spacer" aria-hidden="true"></div>
          <a href="/" class="brand" aria-label="Patoli & Associates, CPA home">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="13 11 42 42" role="img">
                <path d="M19 47V17h17c8.2 0 13 4.5 13 11s-4.8 11-13 11h-9" />
                <path class="brand-accent" d="M27 24.5h9c3.8 0 5.8 1.3 5.8 3.5s-2 3.5-5.8 3.5h-9" />
              </svg>
            </span>
            <span class="brand-type">
              <strong>Patoli &amp; Associates, CPA</strong>
              <small>Tax &middot; Accounting &middot; Advisory</small>
            </span>
          </a>
          <div class="header-action">
            <a href="/contact/" class="btn btn-sm">Contact Us</a>
          </div>
          <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>

      <div class="header-nav-row">
        <nav id="site-nav" class="site-nav container" aria-label="Main navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={
                  currentPath === item.href ||
                  (item.href !== '/' && currentPath.startsWith(item.href))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
          <a href="/contact/" class="nav-contact-mobile">Contact Us</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-col">
          <a href="/" class="brand brand-light" aria-label="Patoli & Associates, CPA home">
            <span class="brand-mark" aria-hidden="true">
              <svg viewBox="13 11 42 42">
                <path d="M19 47V17h17c8.2 0 13 4.5 13 11s-4.8 11-13 11h-9" />
                <path class="brand-accent" d="M27 24.5h9c3.8 0 5.8 1.3 5.8 3.5s-2 3.5-5.8 3.5h-9" />
              </svg>
            </span>
            <span class="brand-type"><strong>Patoli &amp; Associates, CPA</strong><small>Tax &middot; Accounting &middot; Advisory</small></span>
          </a>
          <p class="footer-label">Contact Us</p>
          <p><a href="mailto:info@patolicpa.com" class="footer-email">info@patolicpa.com</a></p>
          <p class="footer-muted">Phone and office address coming soon.</p>
        </div>

        <div class="footer-col">
          <p class="footer-label">Hours</p>
          <ul class="footer-hours">
            <li><span>Monday to Friday</span><span>9:00 AM to 5:00 PM Central</span></li>
            <li><span>Saturday</span><span>Closed</span></li>
            <li><span>Sunday</span><span>Closed</span></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-label">Quick Links</p>
          <nav class="footer-nav" aria-label="Footer navigation">
            <a href="/">Home</a>
            <a href="/services/">Services</a>
            <a href="/new-client/">New Client</a>
            <a href="/resources/">Resources</a>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/portal/">Client Portal</a>
            <a href="/book/">Book an Appointment</a>
          </nav>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>&copy; {new Date().getFullYear()} Patoli &amp; Associates, CPA. All rights reserved.</span>
        <span>Independent private practice</span>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.querySelector<HTMLElement>('.site-nav');

      const closeMenu = () => {
        nav?.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      };

      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });

      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>
