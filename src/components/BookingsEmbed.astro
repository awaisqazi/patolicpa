---
interface Props {
  bookingsUrl: string;
}

const { bookingsUrl } = Astro.props;
---

<div class="bookings-container">
  <iframe
    src={bookingsUrl}
    title="Schedule an appointment with Patoli & Associates, CPA"
    loading="lazy"
    allowfullscreen
  ></iframe>
</div>

<style>
  /* A narrow frame keeps Microsoft Bookings in its single-column layout,
     which fills the frame edge to edge instead of floating in grey gutters. */
  .bookings-container {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    background: #fff;
  }

  .bookings-container iframe {
    display: block;
    width: 100%;
    height: 1750px;
    border: 0;
  }
</style>
