---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

const serviceCards = [
  {
    title: 'Tax Services',
    desc: 'Individual and business tax return preparation, quarterly estimates, multi-state filings, and year-round planning that keeps the next deadline in view.',
    href: '/services/#tax',
  },
  {
    title: 'Accounting & Bookkeeping',
    desc: 'Monthly bookkeeping, reconciliations, QuickBooks setup and cleanup, and financial statements you can actually use to run the business.',
    href: '/services/#accounting',
  },
  {
    title: 'Business Consulting',
    desc: 'Practical guidance on entity structure, budgeting, cash flow, and pricing, grounded in your real numbers rather than general advice.',
    href: '/services/#consulting',
  },
];

const differentiators = [
  {
    kicker: 'Expertise in Tax and Accounting',
    tagline: '"Professional Rigor on Every Return"',
    body: 'Every return and every set of books gets CPA-level review. Complex situations, multiple entities, multi-state filings, rental and investment activity, and prior-year cleanup are handled carefully rather than rushed through.',
  },
  {
    kicker: 'Honesty and Transparency in Every Service',
    tagline: '"Straightforward, Honest Advice You Can Trust"',
    body: 'You will hear clear communication, realistic expectations, and the reasoning behind each recommendation. Scope and pricing are discussed before the work begins, so there are no surprises later.',
  },
  {
    kicker: 'Personalized Service Tailored to Your Needs',
    tagline: '"Your Business Is Our Priority"',
    body: 'There is no one-size-fits-all package here. You get direct access to your CPA, answers in plain language, and a working relationship that continues well past filing season.',
  },
];
---

<Layout
  title="Patoli & Associates, CPA | Tax, Accounting & Business Advisory"
  description="Patoli & Associates, CPA provides individual and business tax preparation, bookkeeping, payroll, and consulting services."
  socialTitle="Patoli & Associates, CPA"
  socialDescription="Certified public accountants and business advisors serving individuals and businesses."
>
  <section class="home-hero">
    <picture class="home-hero-media" aria-hidden="true">
      <source srcset="/images/financial-clarity-hero.webp" type="image/webp" />
      <img src="/images/financial-clarity-hero.png" alt="" width="1536" height="1024" fetchpriority="high" />
    </picture>
    <div class="home-hero-overlay" aria-hidden="true"></div>
    <div class="container home-hero-inner">
      <span class="hero-brand-mark" aria-hidden="true">
        <svg viewBox="13 11 42 42">
          <path d="M19 47V17h17c8.2 0 13 4.5 13 11s-4.8 11-13 11h-9" />
          <path class="brand-accent" d="M27 24.5h9c3.8 0 5.8 1.3 5.8 3.5s-2 3.5-5.8 3.5h-9" />
        </svg>
      </span>
      <h1 class="hero-wordmark">Patoli &amp; Associates, CPA</h1>
      <p class="hero-tagline">Certified Public Accountants and Business Advisors</p>
      <p class="hero-subline">Individual &amp; Business Tax Preparation, Bookkeeping Services, and Consulting</p>
      <a href="/new-client/" class="btn btn-light">Get Started</a>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="split-copy">
        <p class="kicker">About the Practice</p>
        <h2>Trusted Tax and Accounting Guidance for Individuals and Businesses</h2>
        <p>
          At Patoli &amp; Associates, CPA, we provide expert tax, accounting, and
          advisory services for individuals and businesses alike. Whether you need
          help with tax returns, bookkeeping, payroll, or planning for what comes
          next, we are here to guide you every step of the way.
        </p>
        <a href="/about/" class="btn">About Us</a>
      </div>
      <div class="split-media">
        <div class="framed-image">
          <picture>
            <source srcset="/images/financial-clarity-hero.webp" type="image/webp" />
            <img src="/images/financial-clarity-hero.png" alt="Financial documents and a calculator on a desk." width="1536" height="1024" loading="lazy" />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-cream">
    <div class="container">
      <div class="section-head">
        <h2 class="section-heading">Our Services</h2>
        <hr class="divider-rule" />
        <p>
          We are a full-service accounting practice specializing in individual and
          business tax returns, small business consulting, bookkeeping and
          QuickBooks support, payroll, and financial statement preparation and
          analysis. We offer personalized solutions to meet your unique needs.
        </p>
      </div>
      <div class="card-grid">
        {
          serviceCards.map((card) => (
            <article class="info-card">
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
              <a href={card.href} class="btn btn-sm">Read More</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <h2 class="section-heading">What Sets Us Apart?</h2>
        <hr class="divider-rule" />
        <p>
          Our expertise, honesty, and a genuine commitment to your financial
          success. When you choose Patoli &amp; Associates, CPA, you get more than
          an accountant. You get a trusted advisor who speaks your language and has
          your back.
        </p>
      </div>
      <div class="feature-grid">
        {
          differentiators.map((item) => (
            <article class="feature-block">
              <p class="feature-kicker">{item.kicker}</p>
              <p class="feature-tagline">{item.tagline}</p>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
