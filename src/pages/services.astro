---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

const services = [
  {
    id: 'tax',
    mark: 'I',
    title: 'Tax Preparation & Planning',
    desc: 'Federal and state returns for individuals and businesses, paired with proactive planning that keeps the whole year in view.',
    items: [
      'Individual returns (Form 1040)',
      'Business returns (1120, 1120-S, 1065)',
      'Quarterly estimated tax calculations',
      'Multi-state and prior-year filings',
    ],
  },
  {
    id: 'accounting',
    mark: 'II',
    title: 'Accounting & Bookkeeping',
    desc: 'Accurate monthly books and useful reports that let you spend less time sorting transactions and more time running the business.',
    items: [
      'Monthly bookkeeping and reconciliations',
      'Financial statement preparation',
      'QuickBooks setup, cleanup, and training',
      'Accounts payable and receivable support',
    ],
  },
  {
    id: 'payroll',
    mark: 'III',
    title: 'Payroll Services',
    desc: 'Reliable processing with the filings and deposits handled, so your team gets paid on time and your records stay aligned.',
    items: [
      'Payroll processing and direct deposit',
      'Payroll tax filings (941, 940, W-2, 1099)',
      'New hire reporting',
      'Year-end forms and reconciliation',
    ],
  },
  {
    id: 'consulting',
    mark: 'IV',
    title: 'Business Consulting',
    desc: 'Practical guidance grounded in your actual numbers for the decisions that affect cash, growth, and peace of mind.',
    items: [
      'Entity selection and restructuring',
      'Budgeting and cash-flow forecasting',
      'Profitability and pricing analysis',
      'Loan and financing support',
    ],
  },
  {
    id: 'formation',
    mark: 'V',
    title: 'New Business Formation',
    desc: 'A thoughtful launch with the registrations, elections, and financial systems set up correctly from the beginning.',
    items: [
      'Entity formation (LLC, S corp, C corp)',
      'EIN and state registrations',
      'S corporation elections',
      'Accounting system setup',
    ],
  },
  {
    id: 'irs',
    mark: 'VI',
    title: 'IRS Representation',
    desc: 'Steady, professional help when a notice, audit, or unresolved filing is taking too much of your attention.',
    items: [
      'IRS and state notice responses',
      'Audit representation',
      'Back tax filings',
      'Payment plans and offers in compromise',
    ],
  },
];
---

<Layout
  title="Tax, Accounting & Advisory Services | Patoli & Associates, CPA"
  description="Explore tax preparation, bookkeeping, payroll, business consulting, formation, and IRS representation services from Patoli & Associates, CPA."
>
  <section class="page-banner">
    <div class="container">
      <p class="kicker">What We Do</p>
      <h1>Our Services</h1>
      <p>
        Integrated tax, accounting, and advisory services for individuals and
        small businesses. Every engagement begins with a clear scope and a direct
        conversation about what you actually need.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        services.map((service, index) => (
          <article id={service.id} class={`service-block split ${index % 2 === 1 ? 'split-reverse' : ''}`}>
            <div class="split-copy">
              <h2>{service.title}</h2>
              <p>{service.desc}</p>
              <ul class="service-list">
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="split-media">
              <div class="service-figure" aria-hidden="true">
                <span>{service.mark}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand
    kicker="Not Sure Where to Begin?"
    heading="Let's Find the Right Starting Point"
    body="Bring the questions, the paperwork, or simply the sense that something needs attention. We will help identify a sensible next step."
    buttonLabel="Contact Us"
  />
</Layout>
