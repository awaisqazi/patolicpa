---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About | Patoli CPA"
  description="Learn about Patoli CPA, a licensed Certified Public Accountant serving individuals and small businesses."
>
  <div class="page-header">
    <div class="container">
      <h1>About Patoli CPA</h1>
      <p>
        A modern accounting practice built on old-fashioned service: know your
        clients, do excellent work, and always be reachable.
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="prose">
        <h2>Our story</h2>
        <p>
          [PLACEHOLDER: Founder bio. Example: "Patoli CPA was founded by
          [Founder Name], CPA, who spent [X] years at [firm/industry] before
          opening a practice dedicated to individuals and small business
          owners. [He/She/They] holds a [degree] from [university] and is
          licensed in [state]."]
        </p>

        <h2>How we work</h2>
        <p>
          We keep things simple. You get a dedicated CPA who knows your
          situation, responds quickly, and explains things in plain English.
          No jargon, no runaround, and no surprise bills.
        </p>
        <ul>
          <li>Flat, upfront pricing agreed before work begins</li>
          <li>Secure digital document exchange</li>
          <li>Virtual and in-person meetings available</li>
          <li>Year-round availability, not just tax season</li>
        </ul>

        <h2>Credentials</h2>
        <ul>
          <li>[PLACEHOLDER: CPA license number and state]</li>
          <li>[PLACEHOLDER: Professional memberships, e.g. AICPA]</li>
          <li>[PLACEHOLDER: Education]</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <div>
        <h2>Let's talk about your goals</h2>
        <p>The first conversation is always free.</p>
      </div>
      <a href="/contact/" class="btn btn-primary">Contact Us</a>
    </div>
  </section>
</Layout>
