---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Layout
  title="Contact Us | Patoli & Associates, CPA"
  description="Contact Patoli & Associates, CPA about your tax, accounting, or advisory needs."
>
  <section class="page-banner">
    <div class="container">
      <p class="kicker">Contact</p>
      <h1>We're Here to Help</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-heading">Have a Question? We'd Love to Hear From You</h2>
        <hr class="divider-rule" />
        <p>
          Whether you need help with taxes, bookkeeping, or financial advice, we
          are ready to assist you.
        </p>
      </div>

      <div class="contact-layout">
        <div class="contact-info">
          <h2>Contact Information</h2>

          <div class="contact-detail">
            <p class="contact-detail-label">Email</p>
            <p><a href="mailto:info@patolicpa.com">info@patolicpa.com</a></p>
          </div>

          <div class="contact-detail">
            <p class="contact-detail-label">Hours</p>
            <p>Monday through Friday, 9:00 AM to 5:00 PM Central</p>
            <p>Saturday and Sunday, closed</p>
          </div>

          <div class="contact-detail">
            <p class="contact-detail-label">Phone and Office</p>
            <p>Phone number and office address coming soon.</p>
          </div>

          <div class="contact-detail">
            <p class="contact-detail-label">Prefer to Schedule</p>
            <p>Pick a consultation time that works for you.</p>
            <a href="/book/" class="btn btn-sm">Book an Appointment</a>
          </div>

          <p class="small-note" style="margin-top: 1.75rem;">
            Please do not send Social Security numbers, tax documents, or other
            sensitive information by email. Existing clients should use the secure
            portal.
          </p>
        </div>

        <div class="contact-form-block">
          <h2>Send Us a Message</h2>
          <p class="lede">Your message goes straight to the practice inbox. We will reply within one business day.</p>

          <form
            id="contact-form"
            class="contact-form"
            action="https://patoli-contact.awais-a-qazi.workers.dev/submit"
            method="POST"
          >
            <div class="form-row">
              <label class="form-field">
                <span>Name</span>
                <input type="text" name="entry.807866370" autocomplete="name" required />
              </label>
              <label class="form-field">
                <span>Email</span>
                <input type="email" name="entry.837588410" autocomplete="email" required />
              </label>
            </div>
            <label class="form-field">
              <span>Phone (optional)</span>
              <input type="tel" name="entry.435000044" autocomplete="tel" />
            </label>
            <label class="form-field">
              <span>How can we help?</span>
              <textarea name="entry.603333347" rows="6" required></textarea>
            </label>
            <p class="form-privacy">
              Please do not include Social Security numbers or other sensitive
              details in this form.
            </p>
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAELiLI23yrOx5aZ4"></div>
            <button type="submit" class="btn">Send message</button>
            <p id="contact-form-status" class="form-status" role="status" hidden>
              Thank you. Your message has been sent, and we will get back to you
              within one business day.
            </p>
            <p id="contact-form-error" class="form-status form-error" role="alert" hidden>
              Something went wrong and your message was not sent. Please try again,
              or email us directly at info@patolicpa.com.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    kicker="Next Step"
    heading="Ready to Get Started?"
    body="Schedule a consultation and we will talk through your situation and outline a clear next step."
    buttonLabel="Book an Appointment"
    buttonHref="/book/"
  />

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-form-status');
    const error = document.getElementById('contact-form-error');

    if (form) {
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const buttonLabel = button?.textContent ?? '';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (status) status.hidden = true;
        if (error) error.hidden = true;

        if (button) {
          button.disabled = true;
          button.textContent = 'Sending...';
        }

        let sent = false;

        try {
          // Turnstile adds cf-turnstile-response to the form for us.
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
          });
          const result = await response.json().catch(() => null);
          sent = response.ok && result?.ok === true;
        } catch {
          sent = false;
        }

        if (button) {
          button.disabled = false;
          button.textContent = buttonLabel;
        }

        if (sent) {
          form.reset();
          (window as any).turnstile?.reset();
          if (status) status.hidden = false;
        } else {
          if (error) error.hidden = false;
        }
      });
    }
  </script>
</Layout>
