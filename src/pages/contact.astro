---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | Patoli CPA"
  description="Get in touch with Patoli CPA to schedule a free consultation."
>
  <div class="page-header">
    <div class="container">
      <h1>Contact</h1>
      <p>
        Reach out by phone or email and we will get back to you within one
        business day. The first consultation is free.
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="contact-grid">
        <dl class="contact-info">
          <dt>Phone</dt>
          <dd><a href="tel:+15555555555">[PLACEHOLDER: (555) 555-5555]</a></dd>

          <dt>Email</dt>
          <dd>
            <a href="mailto:info@patolicpa.com">[PLACEHOLDER: info@patolicpa.com]</a>
          </dd>

          <dt>Office</dt>
          <dd>
            [PLACEHOLDER: Street Address]<br />
            [PLACEHOLDER: City, State ZIP]
          </dd>

          <dt>Hours</dt>
          <dd>
            Monday to Friday: 9am to 5pm<br />
            Extended hours during tax season
          </dd>
        </dl>

        <div class="contact-note">
          <h2>What to expect</h2>
          <p>
            Send a short note about your situation and what you are looking
            for. We will reply within one business day to set up a free
            introductory call.
          </p>
          <p>
            For existing clients, documents can be shared securely through the
            client portal rather than email.
          </p>
          <p style="margin-top: 1.2rem;">
            <a href="mailto:info@patolicpa.com" class="btn btn-primary">Email Us</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
