---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';

const bookingUrl = 'https://outlook.office.com/book/PatoliAssociatesCPA@patolicpa.com/?ismsaljsauthenabled';
---

<Layout
  title="Book an Appointment | Patoli & Associates, CPA"
  description="Schedule a 45-minute consultation with Patoli & Associates, CPA. Available Monday through Friday, 9 AM to 5 PM Central."
>
  <section class="page-banner">
    <div class="container">
      <p class="kicker">Scheduling</p>
      <h1>Book an Appointment</h1>
      <p>
        Consultations run 45 minutes and are available Monday through Friday,
        9 AM to 5 PM Central. Open the scheduler, pick a time, and you will
        receive a confirmation by email.
      </p>
    </div>
  </section>

  <section class="section booking-section">
    <div class="container booking-layout">
      <div class="booking-grid">
        <article class="booking-card">
          <h2>Availability</h2>
          <ul>
            <li>Monday through Friday</li>
            <li>9 AM to 12 PM and 1 PM to 5 PM Central</li>
            <li>45-minute consultations, starting on the hour</li>
          </ul>
        </article>

        <article class="booking-card">
          <h2>What to expect</h2>
          <ul>
            <li>A focused conversation about your situation and goals</li>
            <li>Clear next steps before the call ends</li>
            <li>A straightforward quote if ongoing work makes sense</li>
          </ul>
        </article>

        <article class="booking-card">
          <h2>Good to know</h2>
          <ul>
            <li>Meetings are held online; a Teams link arrives with your confirmation</li>
            <li>Bookings and cancellations need at least 24 hours notice</li>
            <li>Email reminders are sent automatically</li>
          </ul>
        </article>
      </div>

      <div class="booking-cta">
        <button type="button" class="booking-open" id="open-scheduler">
          Schedule an appointment
        </button>
        <p class="small-note booking-fallback-note">
          Trouble with the scheduler? <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="text-link">Open the booking page in a new tab</a> or <a href="/contact/" class="text-link">send a message</a> and we will help find a time.
        </p>
      </div>
    </div>
  </section>

  <dialog class="booking-modal" id="booking-modal" aria-label="Schedule an appointment">
    <div class="booking-modal-bar">
      <p>Schedule an appointment</p>
      <button type="button" class="booking-close" id="close-scheduler" aria-label="Close scheduler">&times;</button>
    </div>
    <div class="booking-modal-body">
      <iframe
        data-src={bookingUrl}
        title="Schedule an appointment with Patoli & Associates, CPA"
        allowfullscreen
      ></iframe>
    </div>
  </dialog>

  <CtaBand
    kicker="Questions First?"
    heading="Not Sure Which Service You Need?"
    body="Send a short note about your situation and we will point you to a sensible starting point."
    buttonLabel="Contact Us"
  />
</Layout>

<script>
  const modal = document.getElementById('booking-modal') as HTMLDialogElement;
  const frame = modal.querySelector('iframe') as HTMLIFrameElement;

  document.getElementById('open-scheduler')?.addEventListener('click', () => {
    if (!frame.src) frame.src = frame.dataset.src ?? '';
    modal.showModal();
  });

  document.getElementById('close-scheduler')?.addEventListener('click', () => modal.close());

  modal.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
</script>

<style>
  .booking-layout {
    max-width: 960px;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 820px) {
    .booking-grid {
      grid-template-columns: 1fr;
    }
  }

  .booking-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 1.5rem;
  }

  .booking-card h2 {
    font-size: 1.05rem;
    color: var(--forest);
    margin: 0 0 0.75rem;
  }

  .booking-card ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .booking-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  .booking-open {
    font: inherit;
    font-weight: 600;
    color: var(--cream);
    background: var(--forest);
    border: 1px solid var(--forest);
    border-radius: 999px;
    padding: 0.9rem 2.2rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .booking-open:hover {
    background: var(--forest-dark);
  }

  .booking-cta .small-note {
    margin-top: 1rem;
  }

  .booking-fallback-note {
    margin-inline: auto;
    line-height: 1.7;
  }

  /* .text-link is styled as a standalone CTA (inline-flex + top margin);
     inside this running sentence the links must flow as plain text. */
  .booking-fallback-note :global(.text-link) {
    display: inline;
    margin-top: 0;
  }

  .booking-modal {
    margin: auto;
    width: min(440px, calc(100vw - 2rem));
    height: min(760px, calc(100vh - 3rem));
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(13, 43, 39, 0.35);
    overflow: hidden;
    display: none;
    flex-direction: column;
  }

  .booking-modal[open] {
    display: flex;
  }

  .booking-modal::backdrop {
    background: rgba(13, 43, 39, 0.55);
  }

  .booking-modal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--forest);
    color: var(--cream);
    padding: 0.75rem 1.25rem;
  }

  .booking-modal-bar p {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .booking-close {
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--cream);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 0.25rem;
  }

  .booking-modal-body {
    flex: 1;
    background: #fff;
  }

  .booking-modal-body iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
