---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Client Portal | Patoli CPA"
  description="Securely upload documents and access your files through the Patoli CPA client portal."
>
  <div class="page-header">
    <div class="container">
      <h1>Client Portal</h1>
      <p>
        Existing clients can securely upload documents, review returns, and
        exchange files through our client portal.
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="contact-note" style="max-width: 640px;">
        <h2>Access the portal</h2>
        <p>
          [PLACEHOLDER: This button will link to your portal provider (for
          example SmartVault, Canopy, TaxDome, or Drake Portals) once an
          account is set up.]
        </p>
        <p style="margin-top: 1.2rem;">
          <a href="#" class="btn btn-primary" aria-disabled="true">
            Open Client Portal
          </a>
        </p>
        <p>
          Trouble logging in? <a href="/contact/" style="color: var(--accent);">Contact us</a>
          and we will help you get set up.
        </p>
      </div>
    </div>
  </section>
</Layout>
