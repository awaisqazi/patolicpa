---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
---

<Layout
  title="Secure Client Portal | Patoli & Associates, CPA"
  description="Securely upload documents and access files through the Patoli & Associates, CPA client portal."
>
  <section class="page-banner">
    <div class="container">
      <p class="kicker">For Existing Clients</p>
      <h1>Secure Client Portal</h1>
      <p>
        The client portal provides encrypted document exchange and a clear home
        for engagement materials, without sending sensitive information through
        ordinary email.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-heading">Portal Status</h2>
        <hr class="divider-rule" />
      </div>
      <div class="portal-status-card">
        <span class="status-pill"><span></span> Setup in progress</span>
        <p>
          The portal provider and login link will be added here once setup is
          complete. Existing clients who need help in the meantime can contact the
          practice directly.
        </p>
        <a href="/contact/" class="btn btn-sm" style="margin-top: 1.25rem;">Contact Us</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
